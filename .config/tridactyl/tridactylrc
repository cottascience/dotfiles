" Tridactyl config. Needs the native messenger (:nativeinstall) so Tridactyl
" can read this file, the theme, and launch nvim. Reload with :source

" This file is the source of truth: wipe settings changed by hand
sanitise tridactyllocal tridactylsync

colourscheme mocha

" Home-row hints
set hintchars asdfghjkl
set hintfiltermode vimperator-reflow

" Ctrl-i in any text field -> edit it in nvim inside a new Ghostty window
set editorcmd open -nWa Ghostty --args --quit-after-last-window-closed=true -e nvim %f

" Same keywords as the URL bar engines (policies.json): o gh <query>
set searchurls.gh https://github.com/search?q=
set searchurls.hf https://huggingface.co/models?search=
set searchurls.ax https://arxiv.org/search/?searchtype=all&query=
set searchurls.gs https://scholar.google.com/scholar?q=
set searchurls.mdn https://developer.mozilla.org/en-US/search?q=
set searchurls.pypi https://pypi.org/search/?q=
set searchurls.crates https://crates.io/search?q=

" nvim muscle memory (.config/nvim/lua/config/keymaps.lua):
" W/S paragraph up/down -> half page, Q/E line start/end -> top/bottom
bind W scrollpage -0.5
bind S scrollpage 0.5
bind Q scrollto 0
bind E scrollto 100

" Sites with their own keyboard shortcuts
blacklistadd mail.google.com
blacklistadd app.slack.com
blacklistadd docs.google.com
